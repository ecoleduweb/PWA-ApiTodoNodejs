> ```sql
> CREATE TABLE scammistanbank.account (
>     id VARCHAR(36) PRIMARY KEY,
>     userId VARCHAR(36) NOT NULL,
>     balance DECIMAL(15, 2) NOT NULL DEFAULT 10000.00,
>     openedAt TIMESTAMP NOT NULL DEFAULT CURRENT_TIMESTAMP,
>
